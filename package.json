{
  "name": "pinch",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "adb:reverse": "node scripts/adb-reverse.js",
    "android:sdk": "node scripts/ensure-android-sdk.js",
    "prestart": "npm run adb:reverse",
    "start": "expo start",
    "preandroid": "npm run android:sdk && npm run adb:reverse",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "native:prebuild": "expo prebuild --platform android --clean && npm run android:sdk",
    "apk:release": "npm run apk",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "apk:debug": "npm run android:sdk && node scripts/gradle.js assembleDebug",
    "phone": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/copy-to-phone.ps1",
    "apk": "npm run android:sdk && node scripts/gradle.js assembleRelease",
    "apk:clean": "npm run native:prebuild && node scripts/gradle.js assembleRelease",
    "postapk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/copy-to-phone.ps1",
    "postapk:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/copy-to-phone.ps1"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.3",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@react-navigation/bottom-tabs": "^6.6.1",
    "@react-navigation/native": "^6.1.17",
    "@react-navigation/native-stack": "^6.9.26",
    "expo": "~51.0.0",
    "expo-blur": "~13.0.2",
    "expo-device": "~6.0.2",
    "expo-font": "~12.0.10",
    "expo-notifications": "~0.28.19",
    "expo-splash-screen": "^0.27.7",
    "expo-sqlite": "~14.0.6",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1",
    "react-native-svg": "15.2.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/react": "~18.2.79",
    "@types/sql.js": "^1.4.11",
    "babel-preset-expo": "~11.0.0",
    "jest": "^29.7.0",
    "sql.js": "^1.11.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.3.3"
  }
}
