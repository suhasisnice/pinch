{
  "name": "pinch",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "adb:reverse": "node scripts/adb-reverse.js",
    "android:sdk": "node scripts/ensure-android-sdk.js",
    "prestart": "npm run adb:reverse",
    "start": "expo start",
    "preandroid": "npm run android:sdk && npm run adb:reverse",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "native:prebuild": "expo prebuild --platform android --clean && npm run android:sdk && node scripts/android-sync.js --stamp",
    "apk:release": "npm run apk",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "apk:debug": "npm run android:sdk && node scripts/android-sync.js && node scripts/gradle.js assembleDebug",
    "phone": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/copy-to-phone.ps1",
    "apk": "npm run android:sdk && node scripts/android-sync.js && node scripts/gradle.js assembleRelease",
    "apk:clean": "npm run native:prebuild && node scripts/gradle.js assembleRelease",
    "postapk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/copy-to-phone.ps1",
    "postapk:clean": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/copy-to-phone.ps1",
    "prepreview": "node -e \"require('fs').mkdirSync('public',{recursive:true});require('fs').copyFileSync('node_modules/sql.js/dist/sql-wasm.wasm','public/sql-wasm.wasm')\"",
    "preview": "expo start --web --port 8090 --offline",
    "shoot": "node scripts/shoot.js"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7",
    "@react-navigation/native": "^7",
    "@react-navigation/native-stack": "^7",
    "expo": "~57.0.24",
    "expo-blur": "~57.0.3",
    "expo-build-properties": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-device": "~57.0.2",
    "expo-document-picker": "~57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-local-authentication": "~57.0.3",
    "expo-notifications": "~57.0.20",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-sqlite": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@types/jest": "^29.5.12",
    "@types/react": "~19.2.4",
    "@types/sql.js": "^1.4.11",
    "babel-preset-expo": "~57.0.0",
    "jest": "^29.7.0",
    "react-dom": "19.2.3",
    "react-native-web": "^0.21.2",
    "sql.js": "^1.11.0",
    "ts-jest": "^29.2.5",
    "typescript": "~6.0.3"
  }
}
