{
  "expo": {
    "name": "Pinch",
    "slug": "pinch",
    "version": "0.9.17",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "assets/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.suhasisnice.pinch",
      "versionCode": 30,
      "permissions": [
        "RECEIVE_SMS",
        "READ_SMS",
        "READ_CONTACTS",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0D13"
      },
      "allowBackup": false,
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "com.google.android.c2dm.permission.RECEIVE",
        "com.google.android.finsky.permission.BIND_GET_INSTALL_REFERRER_SERVICE",
        "com.anddoes.launcher.permission.UPDATE_COUNT",
        "com.android.launcher.permission.INSTALL_SHORTCUT",
        "com.android.launcher.permission.READ_SETTINGS",
        "com.android.launcher.permission.UNINSTALL_SHORTCUT",
        "com.android.launcher.permission.WRITE_SETTINGS",
        "com.htc.launcher.permission.READ_SETTINGS",
        "com.htc.launcher.permission.UPDATE_SHORTCUT",
        "com.huawei.android.launcher.permission.CHANGE_BADGE",
        "com.huawei.android.launcher.permission.READ_SETTINGS",
        "com.huawei.android.launcher.permission.WRITE_SETTINGS",
        "com.majeur.launcher.permission.UPDATE_BADGE",
        "com.oppo.launcher.permission.READ_SETTINGS",
        "com.oppo.launcher.permission.WRITE_SETTINGS",
        "com.sec.android.provider.badge.permission.READ",
        "com.sec.android.provider.badge.permission.WRITE",
        "com.sonyericsson.home.permission.BROADCAST_BADGE",
        "com.sonymobile.home.permission.PROVIDER_INSERT_BADGE",
        "me.everything.badger.permission.BADGE_COUNT_READ",
        "me.everything.badger.permission.BADGE_COUNT_WRITE",
        "android.permission.READ_APP_BADGE"
      ]
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0F0D13",
      "resizeMode": "contain"
    },
    "androidStatusBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0F0D13"
    },
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0F0D13"
    },
    "plugins": [
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "color": "#D0BCFF",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-font",
      "./plugins/withPackageQueries",
      "./plugins/withGradleTuning",
      "./plugins/withAbiFilter",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-sqlite",
        {
          "useSQLCipher": true
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Pinch uses Face ID to keep your money private."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "# Expo native modules are reached from C++ (JNI) and by reflection, which R8\n# cannot see. 0.9.17's first minified build stripped\n# expo.modules.sqlite.NativeDatabaseBinding and Pinch could not open its\n# database. Keep every Expo module class as-is.\n-keep class expo.modules.** { *; }\n-keep class com.facebook.react.** { *; }\n-keep class com.facebook.jni.** { *; }\n-keep class com.horcrux.svg.** { *; }\n-keep class com.swmansion.** { *; }\n-keep class com.th3rdwave.safeareacontext.** { *; }\n-keep class com.reactnativecommunity.asyncstorage.** { *; }\n-keep class net.zetetic.** { *; }",
            "useLegacyPackaging": true
          }
        }
      ],
      "./plugins/withSqlCipherOpenssl"
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
