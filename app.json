{
  "expo": {
    "name": "Pinch",
    "slug": "pinch",
    "version": "0.8.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.suhasisnice.pinch",
      "versionCode": 12,
      "permissions": [
        "RECEIVE_SMS",
        "READ_SMS",
        "READ_CONTACTS",
        "POST_NOTIFICATIONS",
        "VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E0E10"
      }
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0E0E10",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-splash-screen",
      [
        "expo-notifications",
        {
          "color": "#39FF14",
          "icon": "./assets/notification-icon.png"
        }
      ],
      "expo-font",
      "./plugins/withPackageQueries",
      "./plugins/withGradleTuning",
      "./plugins/withAbiFilter"
    ],
    "icon": "./assets/icon.png",
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
